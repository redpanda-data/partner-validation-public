# Copy to .env.tiered-storage (gitignored) and fill in.
# OCI Object Storage S3-compatibility credentials for Redpanda tiered storage.

# Create the bucket (once):
#   oci os bucket create --name redpanda-tiered-benchmark --compartment-id <compartment-ocid>
S3_BUCKET="redpanda-tiered-benchmark"

# S3-compat endpoint: <object-storage-namespace>.compat.objectstorage.<region>.oraclecloud.com
#   oci os ns get        # prints the namespace
S3_ENDPOINT="CHANGE_ME.compat.objectstorage.us-ashburn-1.oraclecloud.com"
S3_REGION="us-ashburn-1"

# Customer secret key (S3-style access/secret pair for your OCI user):
#   USER_OCID=$(grep '^user=' ~/.oci/config | cut -d= -f2)
#   oci iam customer-secret-key create --user-id $USER_OCID --display-name redpanda-tiered
# The "key" field in the response is the SECRET (shown only once); "id" is the ACCESS key.
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"

# Helm consumes these via --set-string (never commit creds into values files):
#   helm ... --set-string storage.tiered.config.cloud_storage_access_key=$S3_ACCESS_KEY \
#            --set-string storage.tiered.config.cloud_storage_secret_key=$S3_SECRET_KEY
